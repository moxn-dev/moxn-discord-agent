# Copy this file to .env for local development. Never commit the populated file.

# Discord application/bot credentials and the one permitted channel/user.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=

# Temporal Cloud connection. Copy these values from your namespace's Connect page.
TEMPORAL_ADDRESS=your-namespace.account.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.account
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=moxn-discord-agent

# Moxn target workspace and Context CLI API key.
MOXN_WORKSPACE=
MOXN_API_KEY=
# The CLI is the default and supports reads, writes, and local file uploads.
# Optional: also expose the published stdio MCP server to Codex.
MOXN_MCP_ENABLED=false
# MOXN_MCP_TOKEN=  # Optional OAuth bearer; otherwise MCP uses stored OAuth.
# MOXN_BASE_URL=https://app.moxn.dev
# MOXN_VERCEL_BYPASS=

# Persistent private state. Mount this path to durable storage when deployed.
# AGENT_DATA_DIR=/absolute/path/to/private/agent-data
# AGENT_WORKSPACE=/absolute/path/to/agent-persona-directory
# AGENT_PERSONA_FILE=/absolute/path/to/custom/AGENTS.md
# MOXN_MCP_ENTRY=/absolute/path/to/mcp-server-entry.js

# POC tuning.
AGENT_DEBOUNCE_MS=2000
DISCORD_ATTACHMENT_MAX_BYTES=26214400
DISCORD_BACKFILL_LIMIT=100
