# Copy this file to .env for local development. Never commit the populated file.

# Discord application/bot credentials and the permitted guild/channel.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Secure default: accept only this user. For a private channel where every
# human participant may use the agent, set DISCORD_ALLOW_ALL_USERS=true; the
# user ID is then optional. Bot-authored messages require the separate allow-list.
DISCORD_ALLOW_ALL_USERS=false
DISCORD_ALLOWED_USER_ID=
# Optional comma-separated bot IDs whose messages should also reach the agent.
# Never include this agent's own application/bot ID. Keep this list narrow to
# reduce the risk of bot-to-bot reply loops.
# DISCORD_ALLOWED_BOT_IDS=

# Temporal Cloud connection. Copy these values from your namespace's Connect page.
TEMPORAL_ADDRESS=your-namespace.account.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.account
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=moxn-discord-agent

# Moxn target workspace and Context CLI API key.
MOXN_WORKSPACE=
MOXN_API_KEY=
# The CLI is the default and supports reads, writes, and local file uploads.
# Optional: also expose the published stdio MCP server to Codex.
MOXN_MCP_ENABLED=false
# MOXN_MCP_TOKEN=  # Optional OAuth bearer; otherwise MCP uses stored OAuth.
# MOXN_BASE_URL=https://app.moxn.dev
# MOXN_VERCEL_BYPASS=

# OpenAI authentication deliberately does not live in this file. Use one of the
# Codex login commands in README.md or DEPLOYMENT.md; credentials are saved in
# the private persistent CODEX_HOME instead.

# Optional model pinning. Leave these empty to follow Codex defaults. The
# installed Codex SDK accepts minimal, low, medium, high, or xhigh effort.
# CODEX_MODEL=gpt-5.6-terra
# CODEX_REASONING_EFFORT=high
# `workspace-write` is the safer host-process default. When this worker itself
# runs inside the provided Docker boundary, set `danger-full-access` so Codex
# does not try to create a nested Linux Bubblewrap sandbox.
CODEX_SANDBOX_MODE=workspace-write
# Live web search is opt-in because public pages are untrusted input. Accepted
# values are disabled, cached, or live.
CODEX_WEB_SEARCH_MODE=disabled

# Persistent private state. Mount this path to durable storage when deployed.
# AGENT_DATA_DIR=/absolute/path/to/private/agent-data
# CODEX_HOME=/absolute/path/to/private/agent-data/codex
# AGENT_WORKSPACE=/absolute/path/to/agent-persona-directory
# AGENT_PERSONA_FILE=/absolute/path/to/custom/AGENTS.md
# MOXN_MCP_ENTRY=/absolute/path/to/mcp-server-entry.js

# POC tuning.
AGENT_DEBOUNCE_MS=2000
# Applies to all Temporal Activities in this Worker. Four allows a few Codex
# sessions to make progress concurrently while excess work stays in Temporal.
AGENT_MAX_CONCURRENT_ACTIVITIES=4
DISCORD_ATTACHMENT_MAX_BYTES=26214400
DISCORD_BACKFILL_LIMIT=100
